  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## USGS Earthquake Pipeline\n**History** (once): 4.8M quakes since 1970 \u2192 bulk-loaded into **ClickHouse**  \u00b7  **Live** (every 5 min, in Docker): USGS feed \u2192 same table  \u00b7  **Grafana** shows it. Cost: $0."
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "\u2460 How much data: quakes stored (1970 \u2192 now)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT count() AS quakes FROM quakes.events FINAL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "\u2460 It runs by itself: last unattended run",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toUnixTimestamp64Milli(max(finished_at)) AS last_run FROM quakes.ingest_runs WHERE status='ok'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "\u2460 New quakes added in the last hour",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT sum(inserted) AS new_quakes FROM quakes.ingest_runs WHERE status='ok' AND mode IN ('feed','backfill') AND started_at > now() - INTERVAL 1 HOUR AND started_at > (SELECT minIf(started_at, status='ok' AND mode='feed') FROM quakes.ingest_runs)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "\u2461 It's alive: one bar per 5-minute run. Nobody pressed a button.",
      "description": "Each run re-reads the last 24 h of quakes from USGS and keeps only the new ones.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT started_at AS time, inserted AS new_quakes, updated AS revised FROM quakes.ingest_runs WHERE $__timeFilter(started_at) AND status='ok' AND mode IN ('feed','backfill') AND started_at > (SELECT minIf(started_at, status='ok' AND mode='feed') FROM quakes.ingest_runs) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "\u2462 No duplicates: each run re-fetches 24 h, but FINAL = distinct quakes",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT (SELECT count() FROM quakes.events) AS `rows on disk (dups not merged yet)`, (SELECT count() FROM quakes.events FINAL) AS `rows after FINAL dedup`, (SELECT uniqExact(id) FROM quakes.events) AS `distinct quake ids`"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "center",
        "text": {
          "valueSize": 30,
          "titleSize": 16
        }
      }
    },
    {
      "id": 106,
      "type": "timeseries",
      "title": "\u2463 Live vs. history: big quakes (M4.5+) per day, last 30 days, vs. the 2000\u20132025 average",
      "description": "Joins the live trickle to the historical seed in one query.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(toDate(time)) AS day, count() AS per_day, (SELECT countIf(mag >= 4.5) / dateDiff('day', toDate('2000-01-01'), toDate('2026-01-01')) FROM quakes.events FINAL WHERE time >= '2000-01-01' AND time < '2026-01-01') AS avg_2000_2025 FROM quakes.events FINAL WHERE mag >= 4.5 AND time >= today() - 30 GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_2000_2025"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "timeFrom": "30d"
    }
  ]
}