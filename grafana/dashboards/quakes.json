            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT sum(inserted) FROM quakes.ingest_runs WHERE status='ok' AND mode IN ('feed','backfill') AND started_at > now() - INTERVAL 1 HOUR"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
