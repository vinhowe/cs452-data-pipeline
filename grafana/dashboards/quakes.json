    {
      "id": 7,
      "type": "timeseries",
      "title": "It's alive: rows written by each unattended run",
      "description": "One bar pair per scheduled run (every 5 min). Nobody pushes a button.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT started_at AS time, inserted AS new_quakes, updated AS revised FROM quakes.ingest_runs WHERE $__timeFilter(started_at) AND status='ok' AND mode IN ('feed','backfill') ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": 0,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Run ledger (latest first)",
      "description": "Every attempt, success or failure. This is the continuity evidence.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT started_at, mode, status, fetched, inserted, updated, unchanged, round(dateDiff('millisecond', started_at, finished_at)/1000, 1) AS secs, error FROM quakes.ingest_runs ORDER BY started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "geomap",
      "title": "Last 7 days of earthquakes (M1.5+)",
      "description": "Point size scales with magnitude.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT latitude, longitude, mag, place, time FROM quakes.events FINAL WHERE time > now() - INTERVAL 7 DAY AND mag >= 1.5 ORDER BY mag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 20,
          "lon": -100,
          "zoom": 1.3
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Quakes",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "mag",
                  "min": 2,
                  "max": 14,
                  "fixed": 4
                },
                "color": {
                  "field": "mag"
                },
                "opacity": 0.6
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Live vs. history: M4.5+ quakes per day vs. 2000-2025 daily average",
      "description": "Joins the live trickle to the historical seed in one query.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(toDate(time)) AS day, count() AS m45_today, (SELECT countIf(mag >= 4.5) / dateDiff('day', toDate('2000-01-01'), toDate('2026-01-01')) FROM quakes.events FINAL WHERE time >= '2000-01-01' AND time < '2026-01-01') AS avg_2000_2025 FROM quakes.events FINAL WHERE mag >= 4.5 AND time >= today() - 30 GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_2000_2025"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {},
      "timeFrom": "30d",
      "hideTimeOverride": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Quakes per year since 1970: all vs. M5+ (log scale)",
      "description": "The seed. Why does the 'all' line climb while M5+ stays flat?",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(toStartOfYear(time)) AS year, count() AS all_events, countIf(mag >= 5) AS m5_plus FROM quakes.events FINAL WHERE time < toStartOfYear(now()) GROUP BY year ORDER BY year"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "57y"
    }
  ]
}