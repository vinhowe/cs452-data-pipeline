    },
    {
      "id": 2,
      "type": "stat",
      "title": "New quakes, last hour",
      "description": "Never-seen-before events added by unattended runs in the last 60 minutes.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
